rules_version = '2';

// Collezione Jump – regole di sicurezza di Firestore.
// Solo TU (l'utente con questa email) puoi leggere e scrivere. Tutti gli altri non vedono niente.
// ⇩⇩ Sostituisci l'email qui sotto con quella dell'utente creato in Authentication ⇩⇩
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == "LA-TUA-EMAIL@esempio.it";
    }
  }
}
